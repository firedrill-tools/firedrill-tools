{
  "schemaVersion": 1,
  "id": "discord-muted",
  "title": "A Muted member cannot send in #general but can reply in a thread and react",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "sam",
  "task": {
    "instruction": "Run flow:muted against the synthetic Discord Tool and fail loudly on any unexpected status or body."
  },
  "assertions": [
    {
      "id": "send-denied",
      "kind": "operation.count",
      "operation": {
        "packageId": "discord",
        "operationId": "messages.create"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "thread-reply",
      "kind": "operation.count",
      "operation": {
        "packageId": "discord",
        "operationId": "messages.create"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "message-rows",
      "kind": "state.count",
      "packageId": "discord",
      "namespace": "messages",
      "comparison": {
        "operator": "equals",
        "value": 24
      }
    },
    {
      "id": "reaction-added",
      "kind": "event.count",
      "event": {
        "packageId": "discord",
        "eventId": "reaction.added"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    }
  ]
}
