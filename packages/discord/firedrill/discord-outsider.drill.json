{
  "schemaVersion": 1,
  "id": "discord-outsider",
  "title": "A user outside Northwind Makers only sees Orbit Lab",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "lee",
  "task": {
    "instruction": "Run flow:outsider against the synthetic Discord Tool and fail loudly on any unexpected status or body."
  },
  "assertions": [
    {
      "id": "guild-hidden",
