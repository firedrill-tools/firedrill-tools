      "operation": {
        "packageId": "discord",
        "operationId": "guilds.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "channel-hidden",
      "kind": "operation.count",
      "operation": {
        "packageId": "discord",
        "operationId": "channels.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "message-rows",
      "kind": "state.count",
      "packageId": "discord",
      "namespace": "messages",
      "comparison": {
        "operator": "equals",
        "value": 23
      }
    }
  ]
}
