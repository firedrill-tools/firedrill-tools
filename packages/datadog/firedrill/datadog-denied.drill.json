{
  "schemaVersion": 1,
  "id": "datadog-denied",
  "title": "Actor without grants: Firedrill denies calls and nothing changes",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "no-grants",
  "task": {
    "instruction": "Run the denied flow against the synthetic Datadog Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "list-denied",
      "kind": "operation.count",
      "operation": {
        "packageId": "datadog",
        "operationId": "monitors.list"
      },
      "outcomes": [
        "denied"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "create-denied",
      "kind": "operation.count",
      "operation": {
        "packageId": "datadog",
        "operationId": "events.create"
      },
      "outcomes": [
        "denied"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "no-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "datadog",
        "operationId": "events.create"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    },
    {
      "id": "events-count",
      "kind": "state.count",
      "packageId": "datadog",
      "namespace": "events",
      "comparison": {
        "operator": "equals",
        "value": 13
      }
    }
  ]
}
