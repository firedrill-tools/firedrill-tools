{
  "schemaVersion": 1,
  "id": "datadog-tight-limits",
  "title": "Lowered bounds: bounded operations fail with LIMIT_EXCEEDED instead of truncating",
  "targetId": "conformance-agent",
  "scenarioId": "tight-limits",
  "actorId": "admin",
  "task": {
    "instruction": "Run the tight-limits flow against the synthetic Datadog Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "monitors-list-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "datadog",
        "operationId": "monitors.list"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "monitors-delete-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "datadog",
        "operationId": "monitors.delete"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "dashboards-list-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "datadog",
        "operationId": "dashboards.list"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "incidents-update-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "datadog",
        "operationId": "incidents.update"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "monitors-create-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "datadog",
        "operationId": "monitors.create"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 4
      }
    },
    {
      "id": "monitors-count",
      "kind": "state.count",
      "packageId": "datadog",
      "namespace": "monitors",
      "comparison": {
        "operator": "equals",
        "value": 13
      }
    },
    {
      "id": "events-count",
      "kind": "state.count",
      "packageId": "datadog",
      "namespace": "events",
      "comparison": {
        "operator": "equals",
        "value": 13
      }
    }
  ]
}
