{
  "schemaVersion": 1,
  "id": "datadog-readonly",
  "title": "Read Only role: reads succeed, every write is FORBIDDEN and nothing changes",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "readonly",
  "task": {
    "instruction": "Run the readonly flow against the synthetic Datadog Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "monitors-create-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "datadog",
        "operationId": "monitors.create"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "metrics-submit-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "datadog",
        "operationId": "metrics.submit"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "incidents-update-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "datadog",
        "operationId": "incidents.update"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "monitors-validate-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "datadog",
        "operationId": "monitors.validate"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "monitors-count",
      "kind": "state.count",
      "packageId": "datadog",
      "namespace": "monitors",
      "comparison": {
        "operator": "equals",
        "value": 9
      }
    },
    {
      "id": "events-count",
      "kind": "state.count",
      "packageId": "datadog",
      "namespace": "events",
      "comparison": {
        "operator": "equals",
        "value": 13
      }
    },
    {
      "id": "points-count",
      "kind": "state.count",
      "packageId": "datadog",
      "namespace": "metric-points",
      "comparison": {
        "operator": "equals",
        "value": 26
      }
    },
    {
      "id": "dashboards-count",
      "kind": "state.count",
      "packageId": "datadog",
      "namespace": "dashboards",
      "comparison": {
        "operator": "equals",
        "value": 4
      }
    },
    {
      "id": "incidents-count",
      "kind": "state.count",
      "packageId": "datadog",
      "namespace": "incidents",
      "comparison": {
        "operator": "equals",
        "value": 4
      }
    }
  ]
}
