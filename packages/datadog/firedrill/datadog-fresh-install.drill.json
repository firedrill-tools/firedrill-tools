{
  "schemaVersion": 1,
  "id": "datadog-fresh-install",
  "title": "An actor without attributes resolves to the seeded admin and sees seeded data",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "fresh",
  "task": {
    "instruction": "Run the fresh-install flow against the synthetic Datadog Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "org-context-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "datadog",
        "operationId": "org.context"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "monitors-search-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "datadog",
        "operationId": "monitors.search"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "incidents-list-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "datadog",
        "operationId": "incidents.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    }
  ]
}
