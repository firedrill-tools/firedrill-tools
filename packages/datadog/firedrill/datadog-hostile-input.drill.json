{
  "schemaVersion": 1,
  "id": "datadog-hostile-input",
  "title": "Hostile input: reserved keys, deep nesting, malformed encoding and oversized ids answer declared 400/404",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "admin",
  "task": {
    "instruction": "Run the hostile-input flow against the synthetic Datadog Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "monitors-create-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "datadog",
        "operationId": "monitors.create"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "create-invalid",
      "kind": "operation.count",
      "operation": {
        "packageId": "datadog",
        "operationId": "monitors.create"
      },
      "outcomes": [
        "invalid"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "metrics-query-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "datadog",
        "operationId": "metrics.query"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "monitors-get-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "datadog",
        "operationId": "monitors.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "monitors-count",
      "kind": "state.count",
      "packageId": "datadog",
      "namespace": "monitors",
      "comparison": {
        "operator": "equals",
        "value": 9
      }
    }
  ]
}
