{
  "schemaVersion": 1,
  "id": "github-default-identity",
  "title": "An actor without a login attribute (fresh install) acts as the primary seeded user and sees the seeded data",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "newcomer",
  "task": {
    "instruction": "Run the default-identity conformance flow against the synthetic GitHub Tool and fail loudly on any unexpected status or body."
  },
  "assertions": [
    {
      "id": "get-authenticated-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "github",
        "operationId": "users.get-authenticated"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 2
      }
    },
    {
      "id": "list-repos-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "github",
        "operationId": "repos.list-for-authenticated-user"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "issues-list-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "github",
        "operationId": "issues.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "issues-search-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "github",
        "operationId": "issues.search"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "pulls-list-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "github",
        "operationId": "pulls.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "repos-get-private-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "github",
        "operationId": "repos.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "issues-write-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "github",
        "operationId": "issues.write"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "no-unauthorized",
      "kind": "operation.count",
      "operation": {
        "packageId": "github",
        "operationId": "users.get-authenticated"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    },
    {
      "id": "issue-opened",
      "kind": "event.count",
      "event": {
        "packageId": "github",
        "eventId": "issues.changed"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "new-issue-author",
      "kind": "state.value",
      "packageId": "github",
      "namespace": "issues",
      "rowId": "acme-robotics/telemetry-service#00048",
      "path": [
        "user"
      ],
      "comparison": {
        "operator": "equals",
        "value": "dana-reyes"
      }
    },
    {
      "id": "issues",
      "kind": "state.count",
      "packageId": "github",
      "namespace": "issues",
      "comparison": {
        "operator": "equals",
        "value": 16
      }
    }
  ]
}
