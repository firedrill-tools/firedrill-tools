{
  "schemaVersion": 1,
  "id": "github-denied",
  "title": "An actor without grants is denied by the framework over HTTP and MCP",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "auditor",
  "task": {
    "instruction": "Run the denied conformance flow against the synthetic GitHub Tool and fail loudly on any unexpected status or body."
  },
  "assertions": [
    {
      "id": "users-get-authenticated-denied",
      "kind": "operation.denied",
      "operation": {
        "packageId": "github",
        "operationId": "users.get-authenticated"
      },
      "outcomes": [
        "denied"
      ],
      "attemptRequired": true
    },
    {
      "id": "issues-list-denied",
      "kind": "operation.denied",
      "operation": {
        "packageId": "github",
        "operationId": "issues.list"
      },
      "outcomes": [
        "denied"
      ],
      "attemptRequired": true
    },
    {
      "id": "issues-write-denied",
      "kind": "operation.denied",
      "operation": {
        "packageId": "github",
        "operationId": "issues.write"
      },
      "outcomes": [
        "denied"
      ],
      "attemptRequired": true
    },
    {
      "id": "nothing-written",
      "kind": "operation.count",
      "operation": {
        "packageId": "github",
        "operationId": "issues.write"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    },
    {
      "id": "issues",
      "kind": "state.count",
      "packageId": "github",
      "namespace": "issues",
      "comparison": {
        "operator": "equals",
        "value": 15
      }
    }
  ]
}
