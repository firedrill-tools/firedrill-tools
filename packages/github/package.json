{
  "name": "@firedrill-tools/tool-github",
  "version": "0.1.0",
  "description": "Synthetic GitHub instance (REST API 2022-11-28 subset, GitHub MCP server tool names, browser app) Tool package for Firedrill",
  "keywords": [
    "firedrill",
    "tool-pack",
    "github",
    "issues",
    "pull-requests",
    "git",
    "synthetic",
    "testing",
    "ai-agent"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "firedrill",
    "test",
    "firedrill.json",
    "starter.json",
    "README.md",
    "LICENSE"
  ],
  "firedrill": {
    "layer": "tool-pack",
    "tool": "firedrill/tools/github/github.tool.json",
    "starter": "starter.json",
    "lifecycle": "active",
    "conformance": {
      "schemaVersion": 1,
      "project": "firedrill.json",
      "suite": "conformance"
    }
  },
  "scripts": {
    "validate": "firedrill validate",
    "test": "firedrill tool test github"
  },
  "devDependencies": {
    "@firedrill-tools/cli": "0.1.0-rc.1",
    "@firedrill-tools/tool-sdk": "0.1.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firedrill-tools/firedrill-tools.git",
    "directory": "packages/github"
  },
  "bugs": {
    "url": "https://github.com/firedrill-tools/firedrill-tools/issues"
  },
  "homepage": "https://github.com/firedrill-tools/firedrill-tools/tree/main/packages/github#readme",
  "publishConfig": {
    "access": "public"
  }
}
