{
  "schemaVersion": 1,
  "id": "gitlab-invalid-auth-ghost",
  "title": "A username that matches no user fails 401 Unauthorized over REST and MCP",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "ghost",
  "task": {
    "instruction": "Run the invalid-auth-ghost conformance flow against the synthetic GitLab Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "users-get-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "gitlab",
        "operationId": "users.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "issues-create-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "gitlab",
        "operationId": "issues.create"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "merge-requests-list-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "gitlab",
        "operationId": "merge-requests.list"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "rows-issues",
      "kind": "state.count",
      "packageId": "gitlab",
      "namespace": "issues",
      "comparison": {
        "operator": "equals",
        "value": 16
      }
    }
  ]
}
