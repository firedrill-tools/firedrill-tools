{
  "schemaVersion": 1,
  "id": "gitlab-merge-unavailable",
  "title": "Merging and committing answer 503 and write nothing; comments still work",
  "targetId": "conformance-agent",
  "scenarioId": "merge-unavailable",
  "actorId": "owner",
  "task": {
    "instruction": "Run the merge-unavailable conformance flow against the synthetic GitLab Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "merge-requests-merge-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "gitlab",
        "operationId": "merge-requests.merge"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "commits-create-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "gitlab",
        "operationId": "commits.create"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "notes-save-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "gitlab",
        "operationId": "notes.save"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "mr-2-still-open",
      "kind": "state.value",
      "packageId": "gitlab",
      "namespace": "merge_requests",
      "rowId": "p000101!000002",
      "path": [
        "state"
      ],
      "comparison": {
        "operator": "equals",
        "value": "opened"
      }
    },
    {
      "id": "rows-commits",
      "kind": "state.count",
      "packageId": "gitlab",
      "namespace": "commits",
      "comparison": {
        "operator": "equals",
        "value": 13
      }
    },
    {
      "id": "event-merge-request-changed",
      "kind": "event.count",
      "event": {
        "packageId": "gitlab",
        "eventId": "merge-request.changed"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    }
  ]
}
