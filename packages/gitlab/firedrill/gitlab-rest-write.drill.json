{
  "schemaVersion": 1,
  "id": "gitlab-rest-write",
  "title": "REST writes: branches, multi-file commits, issue lifecycle, notes, merge request create/draft/merge and every write error",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "owner",
  "task": {
    "instruction": "Run the rest-write conformance flow against the synthetic GitLab Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "branches-create-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "gitlab",
        "operationId": "branches.create"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "commits-create-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "gitlab",
