{
  "schemaVersion": 1,
  "id": "linkedin-comment-throttled",
  "title": "Comment creation answers 429 and writes nothing",
  "targetId": "conformance-agent",
  "scenarioId": "comment-throttled",
  "actorId": "member",
  "task": {
    "instruction": "Run the comment-throttled flow against the synthetic LinkedIn Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "comments-create-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "linkedin",
        "operationId": "comments.create"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "comments-count",
      "kind": "state.count",
      "packageId": "linkedin",
      "namespace": "comments",
      "comparison": {
        "operator": "equals",
        "value": 12
      }
    },
    {
      "id": "comment-created-events",
      "kind": "event.count",
      "event": {
        "packageId": "linkedin",
        "eventId": "comment.created"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    }
  ]
}
