{
  "schemaVersion": 1,
  "id": "linkedin-posts-lifecycle",
  "title": "Create, read, find, edit, publish and delete posts; validation and ownership errors",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "member",
  "task": {
    "instruction": "Run the posts-lifecycle flow against the synthetic LinkedIn Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "posts-create-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "linkedin",
        "operationId": "posts.create"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "posts-get-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "linkedin",
        "operationId": "posts.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "posts-list-by-author-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "linkedin",
        "operationId": "posts.list_by_author"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "posts-update-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "linkedin",
        "operationId": "posts.update"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "posts-delete-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "linkedin",
        "operationId": "posts.delete"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "posts-create-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "linkedin",
        "operationId": "posts.create"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "posts-get-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "linkedin",
        "operationId": "posts.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "posts-list-by-author-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "linkedin",
        "operationId": "posts.list_by_author"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "posts-update-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "linkedin",
        "operationId": "posts.update"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "posts-delete-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "linkedin",
        "operationId": "posts.delete"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "post-published-events",
      "kind": "event.count",
      "event": {
        "packageId": "linkedin",
        "eventId": "post.published"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 5
      }
    },
    {
      "id": "create-before-delete",
      "kind": "operation.order",
      "sequence": [
        {
          "anyOf": [
            {
              "packageId": "linkedin",
              "operationId": "posts.create"
            }
          ]
        },
        {
          "anyOf": [
            {
              "packageId": "linkedin",
              "operationId": "posts.delete"
            }
          ]
        }
      ]
    },
    {
      "id": "posts-count",
      "kind": "state.count",
      "packageId": "linkedin",
      "namespace": "posts",
      "comparison": {
        "operator": "equals",
        "value": 23
      }
    },
    {
      "id": "comments-count",
      "kind": "state.count",
      "packageId": "linkedin",
      "namespace": "comments",
      "comparison": {
        "operator": "equals",
        "value": 7
      }
    },
    {
      "id": "reactions-count",
      "kind": "state.count",
      "packageId": "linkedin",
      "namespace": "reactions",
      "comparison": {
        "operator": "equals",
        "value": 6
      }
    }
  ]
}
