{
  "schemaVersion": 1,
  "id": "linkedin-reactions-metadata",
  "title": "React, replace, list, delete; social metadata; open and close comments",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "member",
  "task": {
