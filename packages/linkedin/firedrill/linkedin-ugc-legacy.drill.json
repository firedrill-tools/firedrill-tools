{
  "schemaVersion": 1,
  "id": "linkedin-ugc-legacy",
  "title": "Legacy /v2/ugcPosts create and delete",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "member",
  "task": {
    "instruction": "Run the ugc-legacy flow against the synthetic LinkedIn Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "posts-create-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "linkedin",
        "operationId": "posts.create"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "posts-delete-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "linkedin",
        "operationId": "posts.delete"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    }
  ]
}
