{
  "schemaVersion": 1,
  "id": "linkedin-limited-scopes",
  "title": "A token without read scopes can still post",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "limited",
  "task": {
    "instruction": "Run the limited-scopes flow against the synthetic LinkedIn Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "posts-create-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "linkedin",
        "operationId": "posts.create"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "profile-userinfo-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "linkedin",
        "operationId": "profile.userinfo"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "posts-list-by-author-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "linkedin",
        "operationId": "posts.list_by_author"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "feed-list-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "linkedin",
        "operationId": "feed.list"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "connections-list-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "linkedin",
        "operationId": "connections.list"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    }
  ]
}
