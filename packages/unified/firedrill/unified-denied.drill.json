{
  "schemaVersion": 1,
  "id": "unified-denied",
  "title": "An actor without operation grants is refused by the framework before the Tool runs; provider routes still answer the envelope",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "auditor",
  "task": {
    "instruction": "Run the denied flow against the synthetic Unified.to Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "connections-list-denied-154",
      "kind": "operation.count",
      "operation": {
        "packageId": "unified",
        "operationId": "connections.list"
      },
      "outcomes": [
        "denied"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "contacts-list-denied-155",
      "kind": "operation.count",
      "operation": {
        "packageId": "unified",
        "operationId": "contacts.list"
      },
      "outcomes": [
        "denied"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "messages-create-denied-156",
      "kind": "operation.count",
      "operation": {
        "packageId": "unified",
        "operationId": "messages.create"
      },
      "outcomes": [
        "denied"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "messages-create-ok-157",
      "kind": "operation.count",
      "operation": {
        "packageId": "unified",
        "operationId": "messages.create"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    },
    {
      "id": "messages-count-158",
      "kind": "state.count",
      "packageId": "unified",
      "namespace": "messages",
      "comparison": {
        "operator": "equals",
        "value": 20
      }
    }
  ]
