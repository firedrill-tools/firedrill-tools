{
  "schemaVersion": 1,
  "id": "gw-rate-limited",
  "title": "Listings and search answer 429 RESOURCE_EXHAUSTED with Retry-After and write nothing",
  "targetId": "conformance-agent",
  "scenarioId": "rate-limited",
  "actorId": "ada",
  "task": {
    "instruction": "Run the rate-limited flow against the synthetic Google Workspace Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "connections-limited",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "people.list-connections"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "others-limited",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "other-contacts.list"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "groups-limited",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "contact-groups.list"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "subscriptions-limited",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "subscriptions.list"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "processes-limited",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "processes.list"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "search-limited",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "people.search-contacts"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "profile-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "people.get-contact"
      },
      "outcomes": [
