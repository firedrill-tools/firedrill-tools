{
  "schemaVersion": 1,
  "id": "gw-scoped-contacts",
  "title": "A token with the contacts scope only is refused on every Workspace Events and Apps Script call",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "scoped-contacts",
  "task": {
    "instruction": "Run the scoped-contacts flow against the synthetic Google Workspace Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "subscriptions-denied",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "subscriptions.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "run-denied",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "scripts.run"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "processes-denied",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "processes.list"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "connections-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "people.list-connections"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "create-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "people.create-contact"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "one-contact-added",
      "kind": "state.count",
      "packageId": "google-workspace",
      "namespace": "contacts",
      "comparison": {
        "operator": "equals",
        "value": 19
      }
    }
  ]
}
