{
  "schemaVersion": 1,
  "id": "gw-writes-unavailable",
  "title": "Contact writes and content updates answer 503 UNAVAILABLE and leave state byte-identical",
  "targetId": "conformance-agent",
  "scenarioId": "writes-unavailable",
  "actorId": "ada",
  "task": {
    "instruction": "Run the writes-unavailable flow against the synthetic Google Workspace Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "create-unavailable",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "people.create-contact"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "update-unavailable",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "people.update-contact"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "delete-unavailable",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "people.delete-contact"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "content-unavailable",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "script-projects.update-content"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "group-create-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "contact-groups.create"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "no-contact-events",
      "kind": "event.count",
      "event": {
        "packageId": "google-workspace",
        "eventId": "contact.changed"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    },
    {
      "id": "contacts-unchanged",
      "kind": "state.count",
      "packageId": "google-workspace",
      "namespace": "contacts",
      "comparison": {
        "operator": "equals",
        "value": 18
      }
    }
  ]
}
