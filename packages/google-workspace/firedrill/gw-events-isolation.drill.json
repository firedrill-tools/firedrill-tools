{
  "schemaVersion": 1,
  "id": "gw-events-isolation",
  "title": "Another user sees only their own subscriptions and operations",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "bruno",
  "task": {
    "instruction": "Run the events-isolation flow against the synthetic Google Workspace Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "list-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "subscriptions.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "get-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "subscriptions.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "get-errors",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "subscriptions.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "operations-denied",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "operations.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "create-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "subscriptions.create"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "delete-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "subscriptions.delete"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "subscription-events",
      "kind": "event.count",
      "event": {
        "packageId": "google-workspace",
        "eventId": "subscription.state-changed"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "subscriptions-back-to-seed",
      "kind": "state.count",
      "packageId": "google-workspace",
      "namespace": "subscriptions",
      "comparison": {
        "operator": "equals",
        "value": 4
      }
    }
  ]
}
