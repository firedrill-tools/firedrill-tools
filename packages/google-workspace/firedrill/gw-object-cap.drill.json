{
  "schemaVersion": 1,
  "id": "gw-object-cap",
  "title": "At the object cap reads still work and every create answers 429 SIMULATION_OBJECT_LIMIT",
  "targetId": "conformance-agent",
  "scenarioId": "object-cap",
  "actorId": "ada",
  "task": {
    "instruction": "Run the object-cap flow against the synthetic Google Workspace Tool and fail loudly on any unexpected status, header or body."
