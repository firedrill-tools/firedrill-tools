{
  "schemaVersion": 1,
  "id": "gw-denied",
  "title": "An actor without operation grants is refused by the framework before behavior runs",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "no-grants",
  "task": {
    "instruction": "Run the denied flow against the synthetic Google Workspace Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "profile-denied",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "people.get-contact"
      },
      "outcomes": [
        "denied"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "create-denied",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "people.create-contact"
      },
      "outcomes": [
        "denied"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "subscriptions-denied",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-workspace",
        "operationId": "subscriptions.create"
      },
      "outcomes": [
        "denied"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "nothing-written",
      "kind": "state.count",
      "packageId": "google-workspace",
      "namespace": "contacts",
      "comparison": {
        "operator": "equals",
        "value": 18
      }
    }
  ]
}
