{
  "schemaVersion": 1,
  "id": "hubspot-owned-visibility",
  "title": "HubSpot 'owned records only': hidden records are absent from lists and behave as 404",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "sdr",
  "task": {
    "instruction": "Run the owned-visibility conformance flow against the synthetic HubSpot Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "objects-get-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "hubspot",
        "operationId": "objects.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "objects-update-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "hubspot",
        "operationId": "objects.update"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "objects-archive-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "hubspot",
        "operationId": "objects.archive"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "associations-create-default-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "hubspot",
        "operationId": "associations.create-default"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "objects-create-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "hubspot",
        "operationId": "objects.create"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "contact-101-unchanged",
      "kind": "state.value",
      "packageId": "hubspot",
      "namespace": "contacts",
      "rowId": "0000000101",
      "path": [
        "properties",
        "firstname"
      ],
      "comparison": {
        "operator": "equals",
        "value": "Alice"
      }
    },
    {
      "id": "contacts-count",
      "kind": "state.count",
      "packageId": "hubspot",
      "namespace": "contacts",
      "comparison": {
        "operator": "equals",
        "value": 16
      }
    }
  ]
}
