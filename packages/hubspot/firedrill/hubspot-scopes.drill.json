{
  "schemaVersion": 1,
  "id": "hubspot-scopes",
  "title": "A read-only private app: every write fails MISSING_SCOPES with the required granular scopes",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "readonly",
  "task": {
    "instruction": "Run the scopes conformance flow against the synthetic HubSpot Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "objects-create-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "hubspot",
        "operationId": "objects.create"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "objects-update-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "hubspot",
        "operationId": "objects.update"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "objects-archive-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "hubspot",
        "operationId": "objects.archive"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "associations-create-default-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "hubspot",
        "operationId": "associations.create-default"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "objects-batch-create-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "hubspot",
        "operationId": "objects.batch-create"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "objects-list-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "hubspot",
        "operationId": "objects.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "owners-list-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "hubspot",
        "operationId": "owners.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "properties-list-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "hubspot",
        "operationId": "properties.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "contacts-count",
      "kind": "state.count",
      "packageId": "hubspot",
      "namespace": "contacts",
      "comparison": {
        "operator": "equals",
        "value": 14
      }
    },
    {
      "id": "notes-count",
      "kind": "state.count",
      "packageId": "hubspot",
      "namespace": "notes",
      "comparison": {
        "operator": "equals",
        "value": 4
      }
    },
    {
      "id": "object-created-events",
      "kind": "event.count",
      "event": {
        "packageId": "hubspot",
        "eventId": "object.created"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    }
  ]
}
