        "operator": "equals",
        "value": 5
      }
    },
    {
      "id": "job-completed-events",
      "kind": "event.count",
      "event": {
        "packageId": "waterfall",
        "eventId": "job.completed"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 6
