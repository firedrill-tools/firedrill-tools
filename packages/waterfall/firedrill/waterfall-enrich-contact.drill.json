    {
      "id": "contact-phones-billed",
      "kind": "state.value",
      "packageId": "waterfall",
      "namespace": "usage",
      "rowId": "00000001-0000-4000-8000-000000000001/2026-09-16",
      "path": [
        "enrichment_contact_persons_phones"
