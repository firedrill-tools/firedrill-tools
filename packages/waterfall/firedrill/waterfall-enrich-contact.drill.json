      "id": "launch-then-get",
      "kind": "operation.order",
      "sequence": [
        {
          "anyOf": [
            {
              "packageId": "waterfall",
              "operationId": "enrichment.contact.launch"
            }
          ]
        },
        {
          "anyOf": [
