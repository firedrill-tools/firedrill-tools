{
  "schemaVersion": 1,
  "id": "waterfall-enrich-contact",
  "title": "Contact enrichment: every identifier strategy, misses, validation codes, finder errors, seeded due and future jobs",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "master",
  "task": {
    "instruction": "Run the enrich-contact flow against the synthetic Waterfall Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "enrichment-contact-launch-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "waterfall",
        "operationId": "enrichment.contact.launch"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 5
      }
    },
    {
      "id": "enrichment-contact-launch-errors",
      "kind": "operation.count",
      "operation": {
        "packageId": "waterfall",
        "operationId": "enrichment.contact.launch"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 7
      }
    },
    {
      "id": "enrichment-contact-get-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "waterfall",
        "operationId": "enrichment.contact.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 7
      }
    },
    {
      "id": "enrichment-contact-get-errors",
      "kind": "operation.count",
      "operation": {
        "packageId": "waterfall",
        "operationId": "enrichment.contact.get"
      },
      "outcomes": [
        "tool_error"
