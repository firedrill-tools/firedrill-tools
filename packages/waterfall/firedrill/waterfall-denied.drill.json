    },
    {
      "id": "enrichment-contact-get-denied",
      "kind": "operation.count",
      "operation": {
        "packageId": "waterfall",
        "operationId": "enrichment.contact.get"
      },
      "outcomes": [
        "denied"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "account-get-denied",
      "kind": "operation.count",
      "operation": {
        "packageId": "waterfall",
        "operationId": "account.get"
      },
      "outcomes": [
        "denied"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "enrichment-contact-launch-ok",
