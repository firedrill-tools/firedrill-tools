{
  "schemaVersion": 1,
  "id": "waterfall-enrichment-outage",
  "title": "Enrichment launches answer 500 INTERNAL_UNCLASSIFIED_ERROR while search keeps working",
  "targetId": "conformance-agent",
  "scenarioId": "enrichment-outage",
  "actorId": "master",
  "task": {
    "instruction": "Run the enrichment-outage flow against the synthetic Waterfall Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "enrichment-contact-launch-errors-internal_unclassified_error",
      "kind": "operation.count",
      "operation": {
        "packageId": "waterfall",
        "operationId": "enrichment.contact.launch"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "enrichment-phone-launch-errors-internal_unclassified_error",
      "kind": "operation.count",
      "operation": {
        "packageId": "waterfall",
        "operationId": "enrichment.phone.launch"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "enrichment-company-launch-errors-internal_unclassified_error",
      "kind": "operation.count",
      "operation": {
        "packageId": "waterfall",
        "operationId": "enrichment.company.launch"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "search-contact-run-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "waterfall",
        "operationId": "search.contact.run"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "jobs-count",
      "kind": "state.count",
      "packageId": "waterfall",
      "namespace": "jobs",
      "comparison": {
        "operator": "equals",
        "value": 8
      }
    },
    {
      "id": "job-launched-events",
      "kind": "event.count",
      "event": {
        "packageId": "waterfall",
        "eventId": "job.launched"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    }
  ]
}
