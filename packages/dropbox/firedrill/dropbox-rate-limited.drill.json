{
  "schemaVersion": 1,
  "id": "dropbox-rate-limited",
  "title": "Write routes answer 429 too_many_requests with Retry-After and write nothing",
  "targetId": "conformance-agent",
  "scenarioId": "rate-limited",
  "actorId": "owner",
  "task": {
    "instruction": "Run the rate-limited flow against the synthetic Dropbox Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "files-upload-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "dropbox",
        "operationId": "files.upload"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "files-create-folder-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "dropbox",
        "operationId": "files.create-folder"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "files-delete-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "dropbox",
        "operationId": "files.delete"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "files-move-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "dropbox",
        "operationId": "files.move"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "files-copy-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "dropbox",
        "operationId": "files.copy"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "files-restore-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "dropbox",
        "operationId": "files.restore"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "sharing-create-shared-link-with-settings-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "dropbox",
        "operationId": "sharing.create-shared-link-with-settings"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "files-list-folder-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "dropbox",
        "operationId": "files.list-folder"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "entries-count",
      "kind": "state.count",
      "packageId": "dropbox",
      "namespace": "entries",
      "comparison": {
        "operator": "equals",
        "value": 37
      }
    },
    {
      "id": "shared-links-count",
      "kind": "state.count",
      "packageId": "dropbox",
      "namespace": "shared_links",
      "comparison": {
        "operator": "equals",
        "value": 4
      }
    },
    {
      "id": "files-changed-events",
      "kind": "event.count",
      "event": {
        "packageId": "dropbox",
        "eventId": "files.changed"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    }
  ]
}
