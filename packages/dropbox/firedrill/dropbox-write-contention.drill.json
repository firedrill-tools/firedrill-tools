{
  "schemaVersion": 1,
  "id": "dropbox-write-contention",
  "title": "Namespace writes answer 429 too_many_write_operations and write nothing",
  "targetId": "conformance-agent",
  "scenarioId": "write-contention",
  "actorId": "owner",
  "task": {
    "instruction": "Run the write-contention flow against the synthetic Dropbox Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "files-upload-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "dropbox",
        "operationId": "files.upload"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "files-create-folder-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "dropbox",
        "operationId": "files.create-folder"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "files-delete-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "dropbox",
        "operationId": "files.delete"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "files-move-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "dropbox",
        "operationId": "files.move"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "files-restore-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "dropbox",
        "operationId": "files.restore"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "entries-count",
      "kind": "state.count",
      "packageId": "dropbox",
      "namespace": "entries",
      "comparison": {
        "operator": "equals",
        "value": 37
      }
    },
    {
      "id": "files-changed-events",
      "kind": "event.count",
      "event": {
        "packageId": "dropbox",
        "eventId": "files.changed"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    }
  ]
}
