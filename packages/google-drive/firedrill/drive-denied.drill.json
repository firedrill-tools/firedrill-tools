{
  "schemaVersion": 1,
  "id": "drive-denied",
  "title": "An actor without grants is denied by the framework over HTTP (Drive-shaped 403 insufficientPermissions) and MCP (isError)",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "auditor",
  "task": {
    "instruction": "Run the denied conformance flow against the synthetic Google Drive Tool and fail loudly on any unexpected status or body."
  },
  "assertions": [
    {
      "id": "about-get-denied",
      "kind": "operation.denied",
      "operation": {
        "packageId": "google-drive",
        "operationId": "about.get"
      },
      "outcomes": [
        "denied"
      ],
      "attemptRequired": true
    },
    {
      "id": "files-list-denied",
      "kind": "operation.denied",
      "operation": {
        "packageId": "google-drive",
        "operationId": "files.list"
      },
      "outcomes": [
        "denied"
      ],
      "attemptRequired": true
    },
    {
      "id": "about-never-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-drive",
        "operationId": "about.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    },
    {
      "id": "list-never-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-drive",
        "operationId": "files.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    },
    {
      "id": "baseline-untouched",
      "kind": "state.count",
      "packageId": "google-drive",
      "namespace": "files",
      "comparison": {
        "operator": "equals",
        "value": 31
      }
    }
  ]
}
