{
  "schemaVersion": 1,
  "id": "drive-fresh-install",
  "title": "An actor without identity attributes acts as the primary seeded user (Dana): about, listing and a create are hers and no stray user or root appears",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "local-dev",
  "task": {
    "instruction": "Run the fresh-install conformance flow against the synthetic Google Drive Tool and fail loudly on any unexpected status or body."
  },
  "assertions": [
    {
      "id": "about-get-ok-greater_than_or_equal-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-drive",
        "operationId": "about.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "files-list-ok-greater_than_or_equal-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-drive",
        "operationId": "files.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "files-create-ok-equals-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-drive",
        "operationId": "files.create"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "files-delete-ok-equals-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-drive",
        "operationId": "files.delete"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "files-get-tool_error-equals-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-drive",
        "operationId": "files.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "no-stray-user",
      "kind": "state.count",
      "packageId": "google-drive",
      "namespace": "users",
      "comparison": {
        "operator": "equals",
        "value": 3
      }
    },
    {
      "id": "file-rows-unchanged",
      "kind": "state.count",
      "packageId": "google-drive",
      "namespace": "files",
      "comparison": {
        "operator": "equals",
        "value": 31
      }
    },
    {
      "id": "event-file-created-equals-1",
      "kind": "event.count",
      "event": {
        "packageId": "google-drive",
        "eventId": "file.created"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    }
  ]
}
