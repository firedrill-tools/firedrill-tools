{
  "schemaVersion": 1,
  "id": "drive-backend-error",
  "title": "backend-error fault: list, get, create and copy answer 500 global/backendError before any state change; update, permissions and content reads still work",
  "targetId": "conformance-agent",
  "scenarioId": "backend-error",
  "actorId": "owner",
  "task": {
    "instruction": "Run the backend-error conformance flow against the synthetic Google Drive Tool and fail loudly on any unexpected status or body."
  },
  "assertions": [
    {
      "id": "files-list-tool_error-equals-2",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-drive",
        "operationId": "files.list"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "files-get-tool_error-equals-2",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-drive",
        "operationId": "files.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "files-create-tool_error-equals-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-drive",
        "operationId": "files.create"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "files-copy-tool_error-equals-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-drive",
        "operationId": "files.copy"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "list-never-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-drive",
        "operationId": "files.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    },
    {
      "id": "files-update-ok-equals-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-drive",
        "operationId": "files.update"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "permissions-list-ok-greater_than_or_equal-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-drive",
        "operationId": "permissions.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "files-read-content-ok-greater_than_or_equal-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-drive",
        "operationId": "files.read-content"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "event-file-created-equals-0",
      "kind": "event.count",
      "event": {
        "packageId": "google-drive",
        "eventId": "file.created"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    },
    {
      "id": "file-rows-unchanged",
      "kind": "state.count",
      "packageId": "google-drive",
      "namespace": "files",
      "comparison": {
        "operator": "equals",
        "value": 31
      }
    },
    {
      "id": "roadmap-renamed-during-outage",
      "kind": "state.value",
      "packageId": "google-drive",
      "namespace": "files",
      "rowId": "1st000000000000000000000000000007",
      "path": [
        "name"
      ],
      "comparison": {
        "operator": "equals",
        "value": "Renamed during the outage"
      }
    }
  ]
}
