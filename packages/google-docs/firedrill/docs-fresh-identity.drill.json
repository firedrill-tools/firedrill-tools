{
  "schemaVersion": 1,
  "id": "docs-fresh-identity",
  "title": "A grant-only actor with no identity attributes acts as the primary seeded user: a populated home, not an empty account and not an auth error",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "newcomer",
  "task": {
    "instruction": "Run the google-docs conformance flow `fresh-identity` and fail loudly on any unexpected status or body."
  },
  "assertions": [
    {
      "id": "about-get-ok-greater_than_or_equal-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-docs",
        "operationId": "about.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "files-list-ok-greater_than_or_equal-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-docs",
        "operationId": "files.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "documents-get-ok-greater_than_or_equal-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-docs",
        "operationId": "documents.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "documents-create-ok-equals-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-docs",
