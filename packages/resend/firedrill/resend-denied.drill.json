{
  "schemaVersion": 1,
  "id": "resend-denied",
  "title": "Without grants the framework denies calls before the Tool runs",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "no-grants",
  "task": {
    "instruction": "Run the denied flow against the synthetic Resend Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "emails-send-denied",
      "kind": "operation.count",
      "operation": {
        "packageId": "resend",
        "operationId": "emails.send"
      },
      "outcomes": [
        "denied"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "emails-list-denied",
      "kind": "operation.count",
      "operation": {
        "packageId": "resend",
        "operationId": "emails.list"
      },
      "outcomes": [
        "denied"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "emails-send-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "resend",
        "operationId": "emails.send"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    },
    {
      "id": "emails-count",
      "kind": "state.count",
      "packageId": "resend",
      "namespace": "emails",
      "comparison": {
        "operator": "equals",
        "value": 23
      }
    }
  ]
}
