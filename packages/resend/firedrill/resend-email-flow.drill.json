        "value": 4
      }
    },
    {
      "id": "email-bounced-events",
      "kind": "event.count",
      "event": {
        "packageId": "resend",
        "eventId": "email.bounced"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "usage-sent",
      "kind": "state.value",
      "packageId": "resend",
      "namespace": "meta",
      "rowId": "usage",
      "path": [
        "sent"
      ],
      "comparison": {
        "operator": "equals",
        "value": 13
      }
    },
    {
      "id": "send-before-cancel",
      "kind": "operation.order",
      "sequence": [
        {
          "anyOf": [
            {
              "packageId": "resend",
              "operationId": "emails.send"
            }
          ]
        },
        {
          "anyOf": [
            {
              "packageId": "resend",
              "operationId": "emails.get"
            }
          ]
        },
        {
          "anyOf": [
            {
              "packageId": "resend",
              "operationId": "emails.cancel"
            }
          ]
        }
      ]
    }
