        "packageId": "resend",
        "operationId": "emails.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "emails-list-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "resend",
        "operationId": "emails.list"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
