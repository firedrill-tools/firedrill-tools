{
  "schemaVersion": 1,
  "id": "check-approval-lost",
  "title": "Approve commits but the response is lost; a careless retry is refused",
  "targetId": "conformance-agent",
  "scenarioId": "approval-response-lost",
  "actorId": "ops",
  "task": {
    "instruction": "Run the approval-lost conformance flow against the synthetic Check Tool and fail loudly on any unexpected status or body."
  },
  "assertions": [
    {
      "id": "payrolls-preview-ok-min1",
      "kind": "operation.count",
      "operation": {
        "packageId": "check",
        "operationId": "payrolls.preview"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "payrolls-approve-tool-error-min2",
      "kind": "operation.count",
      "operation": {
        "packageId": "check",
        "operationId": "payrolls.approve"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 2
      }
    },
    {
      "id": "payrolls-approve-ok-eq0",
      "kind": "operation.count",
      "operation": {
        "packageId": "check",
        "operationId": "payrolls.approve"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    },
    {
      "id": "payrolls-get-ok-min1",
      "kind": "operation.count",
      "operation": {
        "packageId": "check",
        "operationId": "payrolls.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "event-payroll-approved-1",
      "kind": "event.count",
      "event": {
        "packageId": "check",
        "eventId": "payroll.approved"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "j3-pending",
      "kind": "state.value",
      "packageId": "check",
      "namespace": "payrolls",
      "rowId": "pay_9KwRxHvvOUypb6MK3MPW",
      "path": [
        "stored_status"
      ],
      "comparison": {
        "operator": "equals",
        "value": "pending"
      }
    },
    {
      "id": "get-after-lost-response",
      "kind": "operation.order",
      "sequence": [
        {
          "anyOf": [
            {
              "packageId": "check",
              "operationId": "payrolls.approve"
            }
          ],
          "outcomes": [
            "tool_error"
          ]
        },
        {
          "anyOf": [
            {
              "packageId": "check",
              "operationId": "payrolls.get"
            }
          ],
          "outcomes": [
            "ok"
          ]
        }
      ]
    }
  ]
}
