{
  "schemaVersion": 1,
  "id": "check-company-scope",
  "title": "A key limited to Juniper cannot see Harborview records",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "juniper-only",
  "task": {
    "instruction": "Run the company-scope conformance flow against the synthetic Check Tool and fail loudly on any unexpected status or body."
  },
  "assertions": [
    {
      "id": "companies-list-ok-min1",
      "kind": "operation.count",
      "operation": {
        "packageId": "check",
        "operationId": "companies.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "payrolls-get-tool-error-min1",
      "kind": "operation.count",
      "operation": {
        "packageId": "check",
        "operationId": "payrolls.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "employees-list-ok-min1",
      "kind": "operation.count",
      "operation": {
        "packageId": "check",
        "operationId": "employees.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "payroll-items-create-tool-error-min1",
      "kind": "operation.count",
      "operation": {
        "packageId": "check",
        "operationId": "payroll_items.create"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "count-payroll-items-22",
      "kind": "state.count",
      "packageId": "check",
      "namespace": "payroll_items",
      "comparison": {
        "operator": "equals",
        "value": 22
      }
    }
  ]
}
