{
  "schemaVersion": 1,
  "id": "check-throttled",
  "title": "Throttled lists answer 429 while retrieves still work",
  "targetId": "conformance-agent",
  "scenarioId": "throttled",
  "actorId": "ops",
  "task": {
    "instruction": "Run the throttled conformance flow against the synthetic Check Tool and fail loudly on any unexpected status or body."
