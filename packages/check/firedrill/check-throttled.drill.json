      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "companies-list-ok-eq0",
      "kind": "operation.count",
      "operation": {
        "packageId": "check",
        "operationId": "companies.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    },
