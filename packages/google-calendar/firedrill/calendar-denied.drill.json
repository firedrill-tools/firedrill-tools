{
  "schemaVersion": 1,
  "id": "calendar-denied",
  "title": "An actor without grants is denied by the framework over HTTP (Calendar-shaped 403) and MCP (isError)",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "auditor",
  "task": {
    "instruction": "Run the denied conformance flow against the synthetic Google Calendar Tool and fail loudly on any unexpected status or body."
  },
  "assertions": [
    {
      "id": "calendar-list-denied",
      "kind": "operation.denied",
      "operation": {
        "packageId": "google-calendar",
        "operationId": "calendar-list.list"
      },
      "outcomes": [
        "denied"
      ],
      "attemptRequired": true
    },
    {
      "id": "events-list-denied",
      "kind": "operation.denied",
      "operation": {
        "packageId": "google-calendar",
        "operationId": "events.list"
      },
      "outcomes": [
        "denied"
      ],
      "attemptRequired": true
    },
    {
      "id": "calendar-list-never-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-calendar",
        "operationId": "calendar-list.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    },
    {
      "id": "events-list-never-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-calendar",
        "operationId": "events.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    },
    {
      "id": "baseline-untouched",
      "kind": "state.count",
      "packageId": "google-calendar",
      "namespace": "events",
      "comparison": {
        "operator": "equals",
        "value": 27
      }
    }
  ]
}
