        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "events-patch-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-calendar",
        "operationId": "events.patch"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
