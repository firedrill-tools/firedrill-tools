    },
    {
      "id": "offsite-cancelled",
      "kind": "state.value",
      "packageId": "google-calendar",
      "namespace": "events",
      "rowId": "dana.reyes@example.test:fd000000000000000000000001",
      "path": [
        "status"
      ],
      "comparison": {
        "operator": "equals",
        "value": "cancelled"
      }
    },
    {
      "id": "alias-order",
      "kind": "operation.order",
      "sequence": [
        {
          "anyOf": [
            {
              "packageId": "google-calendar",
              "operationId": "calendar-list.list"
            }
          ]
        },
        {
          "anyOf": [
            {
              "packageId": "google-calendar",
              "operationId": "events.insert"
            }
          ]
        },
        {
          "anyOf": [
            {
              "packageId": "google-calendar",
              "operationId": "events.patch"
            }
          ]
        },
        {
          "anyOf": [
            {
              "packageId": "google-calendar",
              "operationId": "events.respond"
            }
          ]
        },
        {
          "anyOf": [
            {
              "packageId": "google-calendar",
              "operationId": "events.delete"
            }
          ]
        }
      ]
    }
  ]
}
