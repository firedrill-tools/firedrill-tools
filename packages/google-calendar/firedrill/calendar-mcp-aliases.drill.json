      "event": {
        "packageId": "google-calendar",
        "eventId": "event.created"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "updated-events",
      "kind": "event.count",
      "event": {
        "packageId": "google-calendar",
        "eventId": "event.updated"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 2
      }
    },
    {
      "id": "cancelled-events",
      "kind": "event.count",
      "event": {
        "packageId": "google-calendar",
        "eventId": "event.cancelled"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "sam-sees-dana-accepted",
      "kind": "state.value",
      "packageId": "google-calendar",
      "namespace": "events",
      "rowId": "sam.okafor@example.test:st000000000000000000000008",
      "path": [
        "attendees",
        1,
        "responseStatus"
      ],
      "comparison": {
        "operator": "equals",
        "value": "accepted"
      }
    },
    {
      "id": "sam-sees-dana-comment",
      "kind": "state.value",
      "packageId": "google-calendar",
      "namespace": "events",
      "rowId": "sam.okafor@example.test:st000000000000000000000008",
      "path": [
        "attendees",
        1,
        "comment"
      ],
      "comparison": {
