{
  "schemaVersion": 1,
  "id": "calendar-mcp-aliases",
  "title": "Google Calendar MCP tool names (all nine aliases) plus the route-less canonical operations (search, respond, suggest, instances, now) and their errors",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "owner",
  "task": {
    "instruction": "Run the mcp-aliases conformance flow against the synthetic Google Calendar Tool and fail loudly on any unexpected status or body."
  },
  "assertions": [
    {
      "id": "calendar-list-list-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-calendar",
        "operationId": "calendar-list.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "events-list-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-calendar",
        "operationId": "events.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "events-search-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "google-calendar",
        "operationId": "events.search"
      },
