{
  "schemaVersion": 1,
  "id": "documenso-member",
  "title": "A MEMBER sees EVERYONE and own documents only and cannot escalate visibility or manage others' documents",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "member",
  "task": {
    "instruction": "Run the member flow against the synthetic Documenso Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "documents-create-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "documents.create"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "documents-update-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "documents.update"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "documents-delete-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "documents.delete"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "envelopes-cancel-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "envelopes.cancel"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "recipients-reject-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "recipients.reject"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "templates-use-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "templates.use"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "documents-get-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "documents.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "documents-find-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "documents.find"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "documents-delete-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "documents.delete"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "envelopes-cancel-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "envelopes.cancel"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "templates-count",
      "kind": "state.count",
      "packageId": "documenso",
      "namespace": "templates",
      "comparison": {
        "operator": "equals",
        "value": 4
      }
    }
  ]
}
