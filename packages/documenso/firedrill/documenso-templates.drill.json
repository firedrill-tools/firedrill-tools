{
  "schemaVersion": 1,
  "id": "documenso-templates",
  "title": "Find, read and use templates, mapping placeholders and optionally sending",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "admin",
  "task": {
    "instruction": "Run the templates flow against the synthetic Documenso Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "templates-find-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "templates.find"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "templates-get-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "templates.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "templates-use-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "templates.use"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "templates-find-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "templates.find"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "templates-get-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "templates.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "templates-use-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "templates.use"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "document-sent-events",
      "kind": "event.count",
      "event": {
        "packageId": "documenso",
        "eventId": "document.sent"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "documents-count",
      "kind": "state.count",
      "packageId": "documenso",
      "namespace": "documents",
      "comparison": {
        "operator": "equals",
        "value": 20
      }
    }
  ]
}
