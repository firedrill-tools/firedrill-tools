{
  "schemaVersion": 1,
  "id": "documenso-rate-limited",
  "title": "Create, distribute and template use answer 429 with rate-limit headers and write nothing",
  "targetId": "conformance-agent",
  "scenarioId": "rate-limited",
  "actorId": "admin",
  "task": {
    "instruction": "Run the rate-limited flow against the synthetic Documenso Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "documents-create-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "documents.create"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "documents-distribute-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "documents.distribute"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "templates-use-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "templates.use"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "documents-count",
      "kind": "state.count",
      "packageId": "documenso",
      "namespace": "documents",
      "comparison": {
        "operator": "equals",
        "value": 18
      }
    },
    {
      "id": "document-sent-events",
      "kind": "event.count",
      "event": {
        "packageId": "documenso",
        "eventId": "document.sent"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    }
  ]
}
