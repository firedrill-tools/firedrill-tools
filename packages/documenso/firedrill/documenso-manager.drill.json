{
  "schemaVersion": 1,
  "id": "documenso-manager",
  "title": "A MANAGER sees manager-visible documents but not ADMIN ones and may delete others' drafts",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "manager",
  "task": {
    "instruction": "Run the manager flow against the synthetic Documenso Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "documents-find-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "documents.find"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "documents-get-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "documents.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "documents-delete-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "documents.delete"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "documents-get-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "documenso",
        "operationId": "documents.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "documents-count",
      "kind": "state.count",
      "packageId": "documenso",
      "namespace": "documents",
      "comparison": {
        "operator": "equals",
        "value": 17
      }
    }
  ]
}
