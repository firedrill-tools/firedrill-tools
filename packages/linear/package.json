{
  "name": "@firedrill-tools/linear",
  "version": "0.1.1",
  "description": "Synthetic Linear workspace (GraphQL API subset on POST /graphql: viewer, teams, workflow states, labels, projects, cycles, issues, comments; official Linear MCP server tool names) Tool package for Firedrill",
  "keywords": [
    "firedrill",
    "tool-pack",
    "linear",
    "graphql",
    "issues",
    "projects",
    "synthetic",
    "testing",
    "ai-agent"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "firedrill",
    "test",
    "firedrill.json",
    "starter.json",
    "README.md",
    "LICENSE"
  ],
  "firedrill": {
    "layer": "tool-pack",
    "tool": "firedrill/tools/linear/linear.tool.json",
    "starter": "starter.json",
    "lifecycle": "active",
    "conformance": {
      "schemaVersion": 1,
      "project": "firedrill.json",
      "suite": "conformance"
    }
  },
  "scripts": {
    "validate": "firedrill validate",
    "test": "firedrill tool test linear"
  },
  "devDependencies": {
    "@firedrill-run/cli": "0.1.0-rc.1",
    "@firedrill-run/tool-sdk": "0.1.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firedrill-tools/firedrill-tools.git",
    "directory": "packages/linear"
  },
  "bugs": {
    "url": "https://github.com/firedrill-tools/firedrill-tools/issues"
  },
  "homepage": "https://github.com/firedrill-tools/firedrill-tools/tree/main/packages/linear#readme",
  "publishConfig": {
    "access": "public"
  }
}
