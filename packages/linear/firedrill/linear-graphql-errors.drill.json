{
  "schemaVersion": 1,
  "id": "linear-graphql-errors",
  "title": "Parser, validation, catalog and framework-level error paths of POST /graphql",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "admin",
  "task": {
    "instruction": "Run the graphql-errors conformance flow against the synthetic Linear Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "graphql-execute-tool-error-greater-than-or-equal-20",
      "kind": "operation.count",
      "operation": {
        "packageId": "linear",
        "operationId": "graphql.execute"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 20
      }
    },
    {
      "id": "graphql-execute-ok-greater-than-or-equal-2",
      "kind": "operation.count",
      "operation": {
        "packageId": "linear",
        "operationId": "graphql.execute"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 2
      }
    },
    {
      "id": "graphql-execute-invalid-greater-than-or-equal-2",
      "kind": "operation.count",
      "operation": {
        "packageId": "linear",
        "operationId": "graphql.execute"
      },
      "outcomes": [
        "invalid"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 2
      }
    },
    {
      "id": "issues-count-equals-24",
      "kind": "state.count",
      "packageId": "linear",
      "namespace": "issues",
      "comparison": {
        "operator": "equals",
        "value": 24
      }
    },
    {
      "id": "event-issue-updated-equals-0",
      "kind": "event.count",
      "event": {
        "packageId": "linear",
        "eventId": "issue.updated"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    }
  ]
}
