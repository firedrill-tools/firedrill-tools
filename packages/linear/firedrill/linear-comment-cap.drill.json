{
  "schemaVersion": 1,
  "id": "linear-comment-cap",
  "title": "An issue at the 500-comment bound rejects one more with FAILED_PRECONDITION and still pages fully",
  "targetId": "conformance-agent",
  "scenarioId": "comment-cap",
  "actorId": "admin",
  "task": {
    "instruction": "Run the comment-cap conformance flow against the synthetic Linear Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "graphql-execute-tool-error-equals-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "linear",
        "operationId": "graphql.execute"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "graphql-execute-ok-equals-2",
      "kind": "operation.count",
      "operation": {
        "packageId": "linear",
        "operationId": "graphql.execute"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "comments-list-ok-equals-2",
      "kind": "operation.count",
      "operation": {
        "packageId": "linear",
        "operationId": "comments.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "issues-get-ok-equals-6",
      "kind": "operation.count",
      "operation": {
        "packageId": "linear",
        "operationId": "issues.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 6
      }
    },
    {
      "id": "issues-get-tool-error-equals-2",
      "kind": "operation.count",
      "operation": {
        "packageId": "linear",
        "operationId": "issues.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "comments-count-equals-512",
      "kind": "state.count",
      "packageId": "linear",
      "namespace": "comments",
      "comparison": {
        "operator": "equals",
        "value": 512
      }
    },
    {
      "id": "event-comment-created-equals-0",
      "kind": "event.count",
      "event": {
        "packageId": "linear",
        "eventId": "comment.created"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    }
  ]
}
