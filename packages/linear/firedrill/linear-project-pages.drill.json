{
  "schemaVersion": 1,
  "id": "linear-project-pages",
  "title": "A project with more issues than one page: projects.get pages them with a working cursor (shared with GraphQL), never a silently cut list",
  "targetId": "conformance-agent",
  "scenarioId": "project-pages",
  "actorId": "admin",
  "task": {
    "instruction": "Run the project-pages conformance flow against the synthetic Linear Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "projects-get-ok-equals-4",
      "kind": "operation.count",
      "operation": {
        "packageId": "linear",
        "operationId": "projects.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 4
      }
    },
    {
      "id": "projects-get-tool-error-equals-2",
      "kind": "operation.count",
      "operation": {
        "packageId": "linear",
        "operationId": "projects.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "issues-list-ok-equals-7",
      "kind": "operation.count",
      "operation": {
        "packageId": "linear",
        "operationId": "issues.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 7
      }
    },
    {
      "id": "issues-list-tool-error-equals-2",
      "kind": "operation.count",
      "operation": {
        "packageId": "linear",
        "operationId": "issues.list"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "graphql-execute-ok-equals-4",
      "kind": "operation.count",
      "operation": {
        "packageId": "linear",
        "operationId": "graphql.execute"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 4
      }
    },
    {
      "id": "issues-count-equals-284",
      "kind": "state.count",
      "packageId": "linear",
      "namespace": "issues",
      "comparison": {
        "operator": "equals",
        "value": 284
      }
    },
    {
      "id": "event-issue-created-equals-0",
      "kind": "event.count",
      "event": {
        "packageId": "linear",
        "eventId": "issue.created"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    },
    {
      "id": "graphql-execute-tool-error-equals-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "linear",
        "operationId": "graphql.execute"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    }
  ]
}
