{
  "schemaVersion": 1,
  "id": "linear-private-team",
  "title": "A member outside the private SEC team never sees its team, issues, project or memberships",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "member",
  "task": {
    "instruction": "Run the private-team conformance flow against the synthetic Linear Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "graphql-execute-tool-error-equals-5",
      "kind": "operation.count",
      "operation": {
        "packageId": "linear",
        "operationId": "graphql.execute"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 5
      }
    },
    {
      "id": "graphql-execute-ok-greater-than-or-equal-4",
      "kind": "operation.count",
      "operation": {
        "packageId": "linear",
        "operationId": "graphql.execute"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 4
      }
    },
    {
      "id": "eng-10-assigned-to-sofia",
      "kind": "state.value",
      "packageId": "linear",
      "namespace": "issues",
      "rowId": "00000010-0000-4000-8000-00000000000a",
      "path": [
        "assigneeId"
      ],
      "comparison": {
        "operator": "equals",
        "value": "0000000a-0000-4000-8000-000000000003"
      }
    },
    {
      "id": "comments-count-equals-12",
      "kind": "state.count",
      "packageId": "linear",
      "namespace": "comments",
      "comparison": {
        "operator": "equals",
        "value": 12
      }
    },
    {
      "id": "event-issue-updated-equals-1",
      "kind": "event.count",
      "event": {
        "packageId": "linear",
        "eventId": "issue.updated"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    }
  ]
}
