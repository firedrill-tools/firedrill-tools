{
  "schemaVersion": 1,
  "id": "qbo-customers-items",
  "title": "Customer and item create, full and sparse update, deactivation and validation",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "admin",
  "task": {
    "instruction": "Run the customers-items conformance flow against the synthetic QuickBooks Online Tool and fail loudly on any unexpected status or body."
  },
  "assertions": [
    {
      "id": "customers-post-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "quickbooks",
        "operationId": "customers.post"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "items-post-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "quickbooks",
        "operationId": "items.post"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "customers-get-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "quickbooks",
        "operationId": "customers.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "items-get-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "quickbooks",
        "operationId": "items.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "customers-post-tool_error",
      "kind": "operation.count",
      "operation": {
        "packageId": "quickbooks",
        "operationId": "customers.post"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "items-post-tool_error",
      "kind": "operation.count",
      "operation": {
        "packageId": "quickbooks",
        "operationId": "items.post"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "items-get-tool_error",
      "kind": "operation.count",
      "operation": {
        "packageId": "quickbooks",
        "operationId": "items.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "customers-count",
      "kind": "state.count",
      "packageId": "quickbooks",
      "namespace": "customers",
      "comparison": {
        "operator": "equals",
        "value": 15
      }
    },
    {
      "id": "items-count",
      "kind": "state.count",
      "packageId": "quickbooks",
      "namespace": "items",
      "comparison": {
        "operator": "equals",
        "value": 9
      }
    },
    {
      "id": "customer-changed-events",
      "kind": "event.count",
      "event": {
        "packageId": "quickbooks",
        "eventId": "customer.changed"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 5
      }
    },
    {
      "id": "customers-then-items",
      "kind": "operation.order",
      "sequence": [
        {
          "anyOf": [
            {
              "packageId": "quickbooks",
              "operationId": "customers.post"
            }
          ]
        },
        {
          "anyOf": [
            {
              "packageId": "quickbooks",
              "operationId": "items.post"
            }
          ]
        }
      ]
    }
  ]
}
