{
  "schemaVersion": 1,
  "id": "qbo-payment-response-lost",
  "title": "A payment commits but its response is lost; retries show the consequences",
  "targetId": "conformance-agent",
  "scenarioId": "payment-response-lost",
  "actorId": "admin",
  "task": {
    "instruction": "Run the payment-response-lost conformance flow against the synthetic QuickBooks Online Tool and fail loudly on any unexpected status or body."
  },
  "assertions": [
    {
      "id": "payments-post-tool_error",
      "kind": "operation.count",
      "operation": {
        "packageId": "quickbooks",
        "operationId": "payments.post"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 2
      }
    },
    {
      "id": "payments-create-tool_error",
      "kind": "operation.count",
      "operation": {
        "packageId": "quickbooks",
        "operationId": "payments.create"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 2
      }
    },
    {
      "id": "payments-count",
      "kind": "state.count",
      "packageId": "quickbooks",
      "namespace": "payments",
      "comparison": {
        "operator": "equals",
        "value": 9
      }
    },
    {
      "id": "invoice-1043-balance",
      "kind": "state.value",
      "packageId": "quickbooks",
      "namespace": "invoices",
      "rowId": "0000001043",
      "path": [
        "Balance"
      ],
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    },
    {
      "id": "payment-changed-events",
      "kind": "event.count",
      "event": {
        "packageId": "quickbooks",
        "eventId": "payment.changed"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 3
      }
    }
  ]
}
