{
  "schemaVersion": 1,
  "id": "qbo-invoice-lifecycle",
  "title": "Invoice create, duplicate numbers, sparse update, send, PDF, void and delete",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "admin",
  "task": {
    "instruction": "Run the invoice-lifecycle conformance flow against the synthetic QuickBooks Online Tool and fail loudly on any unexpected status or body."
  },
  "assertions": [
    {
      "id": "invoices-post-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "quickbooks",
        "operationId": "invoices.post"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "invoices-send-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "quickbooks",
        "operationId": "invoices.send"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "invoices-pdf-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "quickbooks",
        "operationId": "invoices.pdf"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "invoices-get-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "quickbooks",
        "operationId": "invoices.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "invoices-post-tool_error",
      "kind": "operation.count",
      "operation": {
        "packageId": "quickbooks",
        "operationId": "invoices.post"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "invoices-send-tool_error",
      "kind": "operation.count",
      "operation": {
        "packageId": "quickbooks",
        "operationId": "invoices.send"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "invoices-pdf-tool_error",
      "kind": "operation.count",
      "operation": {
        "packageId": "quickbooks",
        "operationId": "invoices.pdf"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "invoices-get-tool_error",
      "kind": "operation.count",
      "operation": {
        "packageId": "quickbooks",
        "operationId": "invoices.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "invoices-count",
      "kind": "state.count",
      "packageId": "quickbooks",
      "namespace": "invoices",
      "comparison": {
        "operator": "equals",
        "value": 15
      }
    },
    {
      "id": "invoice-1042-voided",
      "kind": "state.value",
      "packageId": "quickbooks",
      "namespace": "invoices",
      "rowId": "0000001042",
      "path": [
        "voided"
      ],
      "comparison": {
        "operator": "equals",
        "value": true
      }
    },
    {
      "id": "deliveries-count",
      "kind": "state.count",
      "packageId": "quickbooks",
      "namespace": "deliveries",
      "comparison": {
        "operator": "equals",
        "value": 3
      }
    },
    {
      "id": "invoice-changed-events",
      "kind": "event.count",
      "event": {
        "packageId": "quickbooks",
        "eventId": "invoice.changed"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 6
      }
    },
    {
      "id": "payment-changed-events",
      "kind": "event.count",
      "event": {
        "packageId": "quickbooks",
        "eventId": "payment.changed"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    }
  ]
}
