{
  "schemaVersion": 1,
  "id": "sheets-append-table",
  "title": "values.append finds the table above the gap row: INSERT_ROWS shifts rows and rewrites formulas, OVERWRITE fills the gap; the unrouted :clear method answers 404",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "avery",
  "task": {
    "instruction": "Run the google-sheets conformance flow `append-table` and fail loudly on any unexpected status or body."
