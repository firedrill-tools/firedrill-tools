{
  "schemaVersion": 1,
  "id": "stripe-large-pages",
  "title": "List pages are filled by encoded bytes below the 1 MiB response cap and resume exactly in both directions; oversized objects answer invalid_request_error",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "owner",
  "task": {
    "instruction": "Run the large-pages conformance flow against the synthetic Stripe Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "customers-create-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "stripe",
        "operationId": "customers.create"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 12
      }
    },
    {
      "id": "customers-list-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "stripe",
        "operationId": "customers.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 10
      }
    },
    {
      "id": "payment-intents-list-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "stripe",
        "operationId": "payment_intents.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 2
      }
    },
    {
      "id": "prices-list-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "stripe",
        "operationId": "prices.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 2
      }
    },
    {
      "id": "refunds-list-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "stripe",
        "operationId": "refunds.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 2
      }
    },
    {
      "id": "invoice-items-too-large",
      "kind": "operation.count",
      "operation": {
        "packageId": "stripe",
        "operationId": "invoice_items.create"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "invoices-retrieve-too-large",
      "kind": "operation.count",
      "operation": {
        "packageId": "stripe",
        "operationId": "invoices.retrieve"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "invoices-list-too-large",
      "kind": "operation.count",
      "operation": {
        "packageId": "stripe",
        "operationId": "invoices.list"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "customers-count",
      "kind": "state.count",
      "packageId": "stripe",
      "namespace": "customers",
      "comparison": {
        "operator": "equals",
        "value": 24
      }
    },
    {
      "id": "prices-count",
      "kind": "state.count",
      "packageId": "stripe",
      "namespace": "prices",
      "comparison": {
        "operator": "equals",
        "value": 111
      }
    }
  ]
}
