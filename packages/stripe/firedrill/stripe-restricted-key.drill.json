{
  "schemaVersion": 1,
  "id": "stripe-restricted-key",
  "title": "A read-only restricted key: reads succeed, every write fails PERMISSION_DENIED (403) naming the missing permission",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "readonly-key",
  "task": {
    "instruction": "Run the restricted-key conformance flow against the synthetic Stripe Tool and fail loudly on any unexpected status, header or body."
