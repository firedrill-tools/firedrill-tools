      "path": [
        "refunded"
      ],
      "comparison": {
        "operator": "equals",
        "value": true
      }
    },
    {
      "id": "charge-amount-refunded",
      "kind": "state.value",
      "packageId": "stripe",
      "namespace": "charges",
      "rowId": "ch_00005Q1YjqV41Z",
      "path": [
        "amount_refunded"
      ],
      "comparison": {
        "operator": "equals",
        "value": 189000
