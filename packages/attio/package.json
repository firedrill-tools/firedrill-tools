{
  "name": "@firedrill-tools/tool-attio",
  "version": "0.1.0",
  "description": "Synthetic Attio workspace (REST API v2 subset: people, companies, deals, attributes, lists and entries, notes, tasks, workspace members) Tool package for Firedrill",
  "keywords": [
    "firedrill",
    "tool-pack",
    "attio",
    "crm",
    "records",
    "lists",
    "synthetic",
    "testing",
    "ai-agent"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "firedrill",
    "test",
    "firedrill.json",
    "starter.json",
    "README.md",
    "LICENSE"
  ],
  "firedrill": {
    "layer": "tool-pack",
    "tool": "firedrill/tools/attio/attio.tool.json",
    "starter": "starter.json",
    "lifecycle": "active",
    "conformance": {
      "schemaVersion": 1,
      "project": "firedrill.json",
      "suite": "conformance"
    }
  },
  "scripts": {
    "validate": "firedrill validate",
    "test": "firedrill tool test attio"
  },
  "devDependencies": {
    "@firedrill-tools/cli": "0.1.0-rc.1",
    "@firedrill-tools/tool-sdk": "0.1.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firedrill-tools/firedrill-tools.git",
    "directory": "packages/attio"
  },
  "bugs": {
    "url": "https://github.com/firedrill-tools/firedrill-tools/issues"
  },
  "homepage": "https://github.com/firedrill-tools/firedrill-tools/tree/main/packages/attio#readme",
  "publishConfig": {
    "access": "public"
  }
}
