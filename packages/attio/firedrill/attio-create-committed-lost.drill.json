{
  "schemaVersion": 1,
  "id": "attio-create-committed-lost",
  "title": "A create whose response is lost has committed: retries conflict or duplicate",
  "targetId": "conformance-agent",
  "scenarioId": "create-committed-lost",
  "actorId": "admin",
  "task": {
    "instruction": "Run the create-committed-lost conformance flow against the synthetic Attio Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
