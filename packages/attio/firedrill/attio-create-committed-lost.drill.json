      "operation": {
        "packageId": "attio",
        "operationId": "records.create"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 4
      }
    },
    {
      "id": "tasks-create-tool_error-eq-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "attio",
        "operationId": "tasks.create"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "count-people-13",
      "kind": "state.count",
      "packageId": "attio",
      "namespace": "people",
      "comparison": {
        "operator": "equals",
        "value": 13
      }
    },
    {
      "id": "count-companies-11",
      "kind": "state.count",
      "packageId": "attio",
      "namespace": "companies",
      "comparison": {
        "operator": "equals",
        "value": 11
      }
    },
    {
      "id": "count-tasks-8",
      "kind": "state.count",
      "packageId": "attio",
      "namespace": "tasks",
      "comparison": {
        "operator": "equals",
        "value": 8
      }
    },
    {
      "id": "event-record-created-3",
      "kind": "event.count",
      "event": {
        "packageId": "attio",
        "eventId": "record.created"
      },
      "phase": "emitted",
