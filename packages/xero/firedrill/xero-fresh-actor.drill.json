{
  "schemaVersion": 1,
  "id": "xero-fresh-actor",
  "title": "An actor without attributes (fresh install) uses the seeded tenant and every scope",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "fresh",
  "task": {
    "instruction": "[fresh] Run the fresh conformance flow against the synthetic Xero Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "contacts-list-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "xero",
        "operationId": "contacts.list"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "organisation-get-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "xero",
        "operationId": "organisation.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "contacts-create-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "xero",
        "operationId": "contacts.create"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "contacts-count",
      "kind": "state.count",
      "packageId": "xero",
      "namespace": "contacts",
      "comparison": {
        "operator": "equals",
        "value": 13
      }
    }
  ]
}
