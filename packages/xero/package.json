{
  "name": "@firedrill-tools/tool-xero",
  "version": "0.1.0",
  "description": "Synthetic Xero Accounting API 2.0 (subset) Tool for Firedrill: organisation, chart of accounts, tax rates, contacts, sales invoices and bills, and payments over deterministic local state.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "firedrill",
    "test",
    "firedrill.json",
    "starter.json",
    "README.md",
    "LICENSE"
  ],
  "firedrill": {
    "layer": "tool-pack",
    "tool": "firedrill/tools/xero/xero.tool.json",
    "starter": "starter.json",
    "lifecycle": "active",
    "conformance": {
      "schemaVersion": 1,
      "project": "firedrill.json",
      "suite": "conformance"
    }
  },
  "scripts": {
    "validate": "firedrill validate",
    "test": "firedrill tool test xero"
  },
  "devDependencies": {
    "@firedrill-tools/cli": "0.1.0-rc.1",
    "@firedrill-tools/tool-sdk": "0.1.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firedrill-tools/firedrill-tools.git",
    "directory": "packages/xero"
  },
  "bugs": {
    "url": "https://github.com/firedrill-tools/firedrill-tools/issues"
  },
  "homepage": "https://github.com/firedrill-tools/firedrill-tools/tree/main/packages/xero#readme",
  "publishConfig": {
    "access": "public"
  }
}
