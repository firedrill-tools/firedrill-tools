{
  "name": "@firedrill-tools/tool-jira",
  "version": "0.1.1",
  "description": "Synthetic Jira Cloud site (REST API v3 issues, JQL search, comments, transitions, users, projects; agile 1.0 boards and sprints; Atlassian Remote MCP Server Jira tool names) Tool package for Firedrill",
  "keywords": [
    "firedrill",
    "tool-pack",
    "jira",
    "atlassian",
    "issues",
    "jql",
    "agile",
    "synthetic",
    "testing",
    "ai-agent"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "firedrill",
    "test",
    "firedrill.json",
    "starter.json",
    "README.md",
    "LICENSE"
  ],
  "firedrill": {
    "layer": "tool-pack",
    "tool": "firedrill/tools/jira/jira.tool.json",
    "starter": "starter.json",
    "lifecycle": "active",
    "conformance": {
      "schemaVersion": 1,
      "project": "firedrill.json",
      "suite": "conformance"
    }
  },
  "scripts": {
    "validate": "firedrill validate",
    "test": "firedrill tool test jira"
  },
  "devDependencies": {
    "@firedrill-run/cli": "0.1.0-rc.1",
    "@firedrill-run/tool-sdk": "0.1.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firedrill-tools/firedrill-tools.git",
    "directory": "packages/jira"
  },
  "bugs": {
    "url": "https://github.com/firedrill-tools/firedrill-tools/issues"
  },
  "homepage": "https://github.com/firedrill-tools/firedrill-tools/tree/main/packages/jira#readme",
  "publishConfig": {
    "access": "public"
  }
}
