{
  "schemaVersion": 1,
  "id": "jira-jql",
  "title": "The documented JQL subset: fields, operators, functions, relative dates, ORDER BY, paging and every rejected construct",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "member",
  "task": {
    "instruction": "Run the jql conformance flow against the synthetic Jira Cloud Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "issues-search-ok-eq-60",
      "kind": "operation.count",
      "operation": {
        "packageId": "jira",
        "operationId": "issues.search"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 60
      }
    },
    {
      "id": "issues-search-tool-error-eq-31",
      "kind": "operation.count",
      "operation": {
        "packageId": "jira",
        "operationId": "issues.search"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 31
      }
    },
    {
      "id": "issues-count-ok-eq-5",
      "kind": "operation.count",
      "operation": {
        "packageId": "jira",
        "operationId": "issues.count"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 5
      }
    },
    {
      "id": "issues-count-tool-error-eq-3",
      "kind": "operation.count",
      "operation": {
        "packageId": "jira",
        "operationId": "issues.count"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 3
      }
    },
    {
      "id": "issues-count-22",
      "kind": "state.count",
      "packageId": "jira",
      "namespace": "issues",
      "comparison": {
        "operator": "equals",
        "value": 22
      }
    },
    {
      "id": "event-issue-updated-eq-0",
      "kind": "event.count",
      "event": {
        "packageId": "jira",
        "eventId": "issue.updated"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    }
  ]
}
