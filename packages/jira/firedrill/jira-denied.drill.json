{
  "schemaVersion": 1,
  "id": "jira-denied",
  "title": "An actor without operation grants is denied by the framework and sees Jira's 403 envelope",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "auditor",
  "task": {
    "instruction": "Run the denied conformance flow against the synthetic Jira Cloud Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "myself-get-denied",
      "kind": "operation.denied",
      "operation": {
        "packageId": "jira",
        "operationId": "myself.get"
      },
      "outcomes": [
        "denied"
      ],
      "attemptRequired": true
    },
    {
      "id": "issues-get-denied",
      "kind": "operation.denied",
      "operation": {
        "packageId": "jira",
        "operationId": "issues.get"
      },
      "outcomes": [
        "denied"
      ],
      "attemptRequired": true
    },
    {
      "id": "issues-create-denied",
      "kind": "operation.denied",
      "operation": {
        "packageId": "jira",
        "operationId": "issues.create"
      },
      "outcomes": [
        "denied"
      ],
      "attemptRequired": true
    },
    {
      "id": "issues-create-ok-eq-0",
      "kind": "operation.count",
      "operation": {
        "packageId": "jira",
        "operationId": "issues.create"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 0
      }
    },
    {
      "id": "issues-count-22",
      "kind": "state.count",
      "packageId": "jira",
      "namespace": "issues",
      "comparison": {
        "operator": "equals",
        "value": 22
      }
    }
  ]
}
