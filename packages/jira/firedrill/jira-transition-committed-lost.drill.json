{
  "schemaVersion": 1,
  "id": "jira-transition-committed-lost",
  "title": "Transitions commit (status, resolution, comment, events) but the caller sees 503; the naive retry then fails 400",
  "targetId": "conformance-agent",
  "scenarioId": "transition-committed-lost",
  "actorId": "admin",
  "task": {
    "instruction": "Run the transition-committed-lost conformance flow against the synthetic Jira Cloud Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
