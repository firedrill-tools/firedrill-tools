      "id": "issues-create-ok-eq-13",
      "kind": "operation.count",
      "operation": {
        "packageId": "jira",
        "operationId": "issues.create"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 13
      }
    },
    {
      "id": "issues-create-tool-error-eq-2",
      "kind": "operation.count",
      "operation": {
        "packageId": "jira",
        "operationId": "issues.create"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
