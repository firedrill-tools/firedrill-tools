{
  "schemaVersion": 1,
  "id": "jira-response-budget",
  "title": "Text over 32,767 characters is refused with a Jira 400; pages of maximum-size issues and comments stay under 1 MiB with every row exactly once",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "admin",
  "task": {
    "instruction": "Run the response-budget conformance flow against the synthetic Jira Cloud Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
