{
  "schemaVersion": 1,
  "id": "jira-oversized-issue",
  "title": "An issue whose bean cannot fit in one response (680 long subtasks) answers a Jira 400 on read and search; narrower fields and child pages still answer 200",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "admin",
  "task": {
    "instruction": "Run the oversized-issue conformance flow against the synthetic Jira Cloud Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "issues-create-ok-eq-680",
      "kind": "operation.count",
      "operation": {
        "packageId": "jira",
        "operationId": "issues.create"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 680
      }
    },
    {
      "id": "issues-get-tool-error-eq-2",
      "kind": "operation.count",
      "operation": {
        "packageId": "jira",
        "operationId": "issues.get"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 2
      }
    },
    {
      "id": "issues-get-ok-eq-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "jira",
        "operationId": "issues.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "issues-search-tool-error-eq-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "jira",
        "operationId": "issues.search"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "issues-search-ok-ge-8",
      "kind": "operation.count",
      "operation": {
        "packageId": "jira",
        "operationId": "issues.search"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 8
      }
    },
    {
      "id": "issues-count-ok-eq-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "jira",
        "operationId": "issues.count"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "issues-count-702",
      "kind": "state.count",
      "packageId": "jira",
      "namespace": "issues",
      "comparison": {
        "operator": "equals",
        "value": 702
      }
    },
    {
      "id": "event-issue-created-eq-680",
      "kind": "event.count",
      "event": {
        "packageId": "jira",
        "eventId": "issue.created"
      },
      "phase": "emitted",
      "comparison": {
        "operator": "equals",
        "value": 680
      }
    }
  ]
}
