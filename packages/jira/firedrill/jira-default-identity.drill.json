      "kind": "operation.count",
      "operation": {
        "packageId": "jira",
        "operationId": "myself.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "projects-search-ok-eq-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "jira",
        "operationId": "projects.search"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "issues-create-ok-eq-1",
      "kind": "operation.count",
      "operation": {
        "packageId": "jira",
        "operationId": "issues.create"
