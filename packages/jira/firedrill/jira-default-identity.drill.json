{
  "schemaVersion": 1,
  "id": "jira-default-identity",
  "title": "An actor without provider attributes (the fresh-install shape) is the seeded default user",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "fresh",
  "task": {
    "instruction": "Run the default-identity conformance flow against the synthetic Jira Cloud Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
