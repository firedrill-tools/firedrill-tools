{
  "schemaVersion": 1,
  "id": "ns-analytics",
  "title": "SuiteQL, the MCP-shaped record read and the metadata catalog",
  "targetId": "conformance-agent",
  "scenarioId": "baseline",
  "actorId": "administrator",
  "task": {
    "instruction": "Run the analytics conformance flow against the synthetic NetSuite Tool and fail loudly on any unexpected status or body."
  },
  "assertions": [
    {
      "id": "suiteql-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "netsuite",
        "operationId": "suiteql.query"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "suiteql-run-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "netsuite",
        "operationId": "suiteql.run"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "record-get-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "netsuite",
        "operationId": "record.get"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 1
      }
    },
    {
      "id": "metadata-ok",
      "kind": "operation.count",
      "operation": {
        "packageId": "netsuite",
        "operationId": "record.metadata"
      },
      "outcomes": [
        "ok"
      ],
      "comparison": {
        "operator": "greater_than_or_equal",
        "value": 2
      }
    }
  ]
}
