    {
      "id": "order-31",
      "kind": "operation.order",
      "sequence": [
        {
          "anyOf": [
            {
              "packageId": "unstructured",
              "operationId": "workflows.create"
            }
          ]
        },
        {
          "anyOf": [
            {
              "packageId": "unstructured",
              "operationId": "workflows.run"
            }
          ]
        },
        {
          "anyOf": [
            {
              "packageId": "unstructured",
              "operationId": "jobs.get"
            }
          ]
        },
        {
          "anyOf": [
            {
              "packageId": "unstructured",
              "operationId": "jobs.download_output"
            }
          ]
        },
        {
          "anyOf": [
            {
              "packageId": "unstructured",
              "operationId": "jobs.cancel"
            }
          ]
        },
        {
          "anyOf": [
            {
              "packageId": "unstructured",
              "operationId": "workflows.delete"
            }
          ]
        }
