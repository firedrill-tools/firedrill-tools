{
  "schemaVersion": 1,
  "id": "box-writes-unavailable",
  "title": "Uploads, copies and folder creation answer 503 and write nothing",
  "targetId": "conformance-agent",
  "scenarioId": "writes-unavailable",
  "actorId": "maya",
  "task": {
    "instruction": "Run the writes-unavailable flow against the synthetic Box Tool and fail loudly on any unexpected status, header or body."
  },
  "assertions": [
    {
      "id": "files-upload-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "box",
        "operationId": "files.upload"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "files-upload-version-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "box",
        "operationId": "files.upload-version"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "files-copy-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "box",
        "operationId": "files.copy"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "folders-create-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "box",
        "operationId": "folders.create"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "folders-copy-tool-error",
      "kind": "operation.count",
      "operation": {
        "packageId": "box",
        "operationId": "folders.copy"
      },
      "outcomes": [
        "tool_error"
      ],
      "comparison": {
        "operator": "equals",
        "value": 1
      }
    },
    {
      "id": "files-count",
      "kind": "state.count",
      "packageId": "box",
      "namespace": "files",
      "comparison": {
        "operator": "equals",
        "value": 24
      }
    },
    {
      "id": "folders-count",
      "kind": "state.count",
      "packageId": "box",
      "namespace": "folders",
      "comparison": {
        "operator": "equals",
        "value": 11
      }
    },
    {
      "id": "versions-count",
      "kind": "state.count",
      "packageId": "box",
      "namespace": "versions",
      "comparison": {
        "operator": "equals",
        "value": 26
      }
    }
  ]
}
